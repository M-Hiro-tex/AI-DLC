# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration (Aurora Serverless v2 with RDS Data API)
DB_CLUSTER_ARN=arn:aws:rds:ap-northeast-1:123456789012:cluster:your-cluster-name
DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:your-secret-name
DB_NAME=auth_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=3h
JWT_ISSUER=aidlc-auth-service
JWT_AUDIENCE=aidlc-frontend

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Configuration (Production)
AWS_REGION=ap-northeast-1
AWS_SECRETS_MANAGER_SECRET_ID=aidlc-auth-secrets

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_STATE_EXPIRY_MINUTES=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CloudWatch (Production)
CLOUDWATCH_LOG_GROUP=/aws/lambda/u2-authentication
CLOUDWATCH_LOG_STREAM=authentication-service

# X-Ray Tracing (Production)
XRAY_ENABLED=false
XRAY_SAMPLING_RATE=0.1

# CORS Configuration
CORS_ENABLED=true
CORS_CREDENTIALS=true

# Security
HELMET_ENABLED=true
TRUST_PROXY=false